# ── Secrets ─────────────────────────────────────────────────────────────────────
# Nothing here may ever reach a remote. Each has a committed .example alongside it
# showing the shape without the value.
**/lib/core/config/api_secrets.dart
**/android/key.properties
**/*.jks
**/*.keystore
**/*.p12
**/*.pem
**/.env
**/.env.local
**/.env.*.local
**/google-services.json
**/GoogleService-Info.plist
**/firebase_options.dart

# Anything a wallet writes about a wallet. These never belong in a repository.
**/*.wallet
**/wallets.json
**/flutter_secure_storage.dat

# ── Build output ────────────────────────────────────────────────────────────────
build/
.dart_tool/
.packages
.pub-cache/
.pub/
*.lock.bak
coverage/

# Flutter's generated platform glue — regenerated by `flutter pub get`.
**/generated_plugin_registrant.dart
**/GeneratedPluginRegistrant.*
**/generated_plugins.cmake
**/flutter_export_environment.sh
**/Generated.xcconfig
**/.flutter-plugins
**/.flutter-plugins-dependencies
**/windows/flutter/ephemeral/
**/linux/flutter/ephemeral/
**/macos/Flutter/ephemeral/
**/ios/Flutter/ephemeral/
**/ios/Flutter/Flutter.framework
**/ios/Flutter/Flutter.podspec
**/ios/Pods/
**/macos/Pods/
**/ios/.symlinks/
**/macos/.symlinks/

# Android
**/android/.gradle/
**/android/local.properties
**/android/app/debug/
**/android/app/profile/
**/android/app/release/
**/android/captures/
*.iml

# The installer's own output — a 13 MB binary rebuilt from source on demand.
**/installer_output/

# Node dependencies of the branding tool. `npm install` restores them; the platform binaries
# inside are tens of megabytes and are wrong for any machine but the one that fetched them.
**/node_modules/

# ── Editors and operating systems ───────────────────────────────────────────────
.idea/
.vscode/
*.swp
*~
.DS_Store
Thumbs.db
desktop.ini
