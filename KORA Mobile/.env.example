# API KEYS CONFIGURATION
# Скопіюйте цей файл як .env та заповніть своїми ключами

# MetaMask Developer API (Infura Alternative)
# Отримати: https://developer.metamask.io/
METAMASK_API_KEY=your_metamask_api_key_here

# Etherscan API
# Отримати: https://etherscan.io/apis
ETHERSCAN_API_KEY=your_etherscan_api_key_here

# CoinGecko API (не потрібен для безкоштовного плану)
# COINGECKO_API_KEY=not_required
